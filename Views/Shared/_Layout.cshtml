<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="Forside for festivalnettside (Mappe 2) med forbedringer basert på evaluering i Mappe 1." />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
